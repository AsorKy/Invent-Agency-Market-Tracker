{
  "id": "wf-computrabajo-tech",
  "name": "wf_computrabajo_tech",
  "description": "Computrabajo tech jobs run every 12 hours: check the ingest budget, trigger the scraper with the ingest webhook as notify URL, and notify the team.",
  "active": false,
  "versionId": "1.0.0",
  "meta": {
    "payloadVersion": "1"
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */12 * * *"
            }
          ]
        }
      },
      "id": "computrabajo_tech-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.INGEST_URL}}/internal/ingest/budget/computrabajo",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ingest-internal",
          "name": "ingest-internal-header"
        }
      },
      "id": "computrabajo_tech-budget",
      "name": "Check ingest budget",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BRIGHT_DATA_API_URL}}/datasets/v3/trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"dataset_id\":\"computrabajo-tech-co\",\"inputs\":{\"country\": \"CO\", \"category\": \"tech\"},\"notify\":\"{{$env.INGEST_WEBHOOK_URL}}\"}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "brightdata-api",
          "name": "brightdata-api-header"
        }
      },
      "id": "computrabajo_tech-trigger",
      "name": "Trigger Bright Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.TELEGRAM_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\":\"Ingest run started: computrabajo-tech-co\"}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "computrabajo_tech-notify-ok",
      "name": "Notify run started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {},
      "id": "computrabajo_tech-error",
      "name": "Error trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        260,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.TELEGRAM_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\":\"Ingest run failed or blocked by budget: computrabajo-tech-co\"}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "computrabajo_tech-notify-fail",
      "name": "Notify run failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        520
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Check ingest budget",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check ingest budget": {
      "main": [
        [
          {
            "node": "Trigger Bright Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Bright Data": {
      "main": [
        [
          {
            "node": "Notify run started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error trigger": {
      "main": [
        [
          {
            "node": "Notify run failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
