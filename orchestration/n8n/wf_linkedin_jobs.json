{
  "id": "wf-linkedin-jobs",
  "name": "wf_linkedin_jobs",
  "description": "Weekly LinkedIn Jobs Colombia run: check the ingest budget, trigger Bright Data with the ingest webhook as notify URL, and notify the team.",
  "active": false,
  "versionId": "1.0.0",
  "meta": {
    "payloadVersion": "1"
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 1"
            }
          ]
        }
      },
      "id": "linkedin_jobs-schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.INGEST_URL}}/internal/ingest/budget/linkedin_jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "linkedin_jobs-budget",
      "name": "Check ingest budget",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ingest-internal",
          "name": "ingest-internal-header"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BRIGHT_DATA_API_URL}}/datasets/v3/trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"dataset_id\":\"linkedin-jobs-co\",\"inputs\":{\"country\": \"CO\"},\"notify\":\"{{$env.INGEST_WEBHOOK_URL}}\"}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "linkedin_jobs-trigger",
      "name": "Trigger Bright Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "brightdata-api",
          "name": "brightdata-api-header"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.TELEGRAM_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\":\"Ingest run started: linkedin-jobs-co\"}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "linkedin_jobs-notify-ok",
      "name": "Notify run started",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ]
    },
    {
      "parameters": {},
      "id": "linkedin_jobs-error",
      "name": "Error trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        260,
        520
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.TELEGRAM_WEBHOOK_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\":\"Ingest run failed or blocked by budget: linkedin-jobs-co\"}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "linkedin_jobs-notify-fail",
      "name": "Notify run failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        520
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Check ingest budget",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check ingest budget": {
      "main": [
        [
          {
            "node": "Trigger Bright Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Bright Data": {
      "main": [
        [
          {
            "node": "Notify run started",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error trigger": {
      "main": [
        [
          {
            "node": "Notify run failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
