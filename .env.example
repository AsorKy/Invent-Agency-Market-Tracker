# Local environment variables for APIs, workers, Postgres, Redis, and n8n.
# Relates to libs/common/settings.py and docker-compose.yml; copy to .env and
# replace secrets before using any shared environment.
ENVIRONMENT=local
APP_VERSION=dev
LOG_LEVEL=INFO
SERVICE_NAME=invent-market-tracker

# Local Postgres. Supabase uses the same variables with its transaction pooler
# and statement cache disabled by the service drivers.
POSTGRES_DB=invent_market_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/invent_market_tracker
REDIS_URL=redis://redis:6379/0

# Gateway host mapping and routes. The gateway deliberately has no DATABASE_URL.
GATEWAY_PORT=8000
INGEST_URL=http://ingest:8000
CORE_URL=http://core:8000
ANALYTICS_URL=http://analytics:8000
ML_URL=http://ml:8000
IDENTITY_URL=http://identity:8000
PULSE_URL=http://pulse:8000
BRIEF_URL=http://brief:8000
STREAMLIT_URL=http://streamlit:8501
STREAMLIT_PORT=8501
EDGE_SECRET=
EDGE_SECRET_REQUIRED=false
CSRF_REQUIRED=false
IDENTITY_VALIDATION_ENABLED=false
BRIGHT_DATA_WEBHOOK_SECRET=
BRIGHT_DATA_REPLAY_WINDOW_SECONDS=300
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
TRUST_PROXY_HEADERS=false
UPSTREAM_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_SECONDS=2
UPSTREAM_RETRY_ATTEMPTS=2
WORKER_RETRY_ATTEMPTS=3
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=0
DATABASE_SSL_MODE=prefer
REDIS_SOCKET_TIMEOUT_SECONDS=10
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
INGEST_ENQUEUE_MARK_TTL_SECONDS=86400
SCORE_LOCK_TTL_SECONDS=30
WORKER_STREAM_BLOCK_MS=5000
WORKER_FAILURE_SLEEP_SECONDS=1
OUTBOX_POLL_INTERVAL_SECONDS=1
UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.1
UPSTREAM_RETRY_MAX_DELAY_SECONDS=2
UPSTREAM_RETRY_JITTER_RATIO=0.2
WORKER_RETRY_BASE_DELAY_SECONDS=1
WORKER_RETRY_MAX_DELAY_SECONDS=30
WORKER_RETRY_JITTER_RATIO=0.25

# Internal service authentication placeholder for F0.
INTERNAL_SERVICE_TOKEN=local-development-token

# n8n / Bright Data are intentionally disabled until credentials are supplied.
BRIGHT_DATA_API_URL=https://api.brightdata.com
BRIGHT_DATA_API_TOKEN=
INGEST_WEBHOOK_URL=http://gateway:8000/api/v1/ingest/webhook/bd
TELEGRAM_WEBHOOK_URL=http://mocks:8000/mocks/telegram
N8N_ENCRYPTION_KEY=replace-me-for-local-use

