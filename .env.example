# Local environment variables for APIs, workers, Postgres, Redis, and n8n.
# Relates to libs/common/settings.py and docker-compose.yml; copy to .env and
# replace secrets before using any shared environment.
ENVIRONMENT=local
APP_VERSION=dev
LOG_LEVEL=INFO
SERVICE_NAME=invent-market-tracker

# Local Postgres. Supabase uses the same variables with its transaction pooler
# and statement cache disabled by the service drivers.
POSTGRES_DB=invent_market_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/invent_market_tracker
# Redis ACL users (REQ-SEC-005): edge = gateway rate limits, data = streams and locks.
# Compose builds each service REDIS_URL from these; blank uses the local defaults.
# make invent-tracker generates both passwords (and rewrites REDIS_URL) in a new .env.
REDIS_URL=redis://data:local-redis-data@redis:6379/0
REDIS_EDGE_PASSWORD=
REDIS_DATA_PASSWORD=

# Optional data UI (`make db-ui`): pgAdmin on loopback only, no pgAdmin login in local use.
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-only

# Gateway host mapping and routes. The gateway deliberately has no DATABASE_URL.
GATEWAY_PORT=8000
INGEST_URL=http://ingest:8000
CORE_URL=http://core:8000
# Compose also gives CORE_URL to the ml service (tenant score weights); it signs its token
# with INTERNAL_SERVICE_TOKEN and still scores with defaults when core is down.
ML_URL=http://ml:8000
IDENTITY_URL=http://identity:8000
PULSE_URL=http://pulse:8000
BRIEF_URL=http://brief:8000
STREAMLIT_URL=http://streamlit:8501
STREAMLIT_PORT=8501
EDGE_SECRET=
EDGE_SECRET_REQUIRED=false
CSRF_REQUIRED=false
IDENTITY_VALIDATION_ENABLED=false
BRIGHT_DATA_WEBHOOK_SECRET=
BRIGHT_DATA_REPLAY_WINDOW_SECONDS=300
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
TRUST_PROXY_HEADERS=false
UPSTREAM_TIMEOUT_SECONDS=10
READINESS_TIMEOUT_SECONDS=2
UPSTREAM_RETRY_ATTEMPTS=2
WORKER_RETRY_ATTEMPTS=3
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=0
DATABASE_SSL_MODE=prefer
REDIS_SOCKET_TIMEOUT_SECONDS=10
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
INGEST_ENQUEUE_MARK_TTL_SECONDS=86400
SCORE_LOCK_TTL_SECONDS=30
WORKER_STREAM_BLOCK_MS=5000
WORKER_FAILURE_SLEEP_SECONDS=1
SHUTDOWN_GRACE_SECONDS=25
OUTBOX_POLL_INTERVAL_SECONDS=1
# Emit the L2 event chain events besides funnel.gate_decision (REQ-LNS-012); keep false until e2e is green.
EVENT_CHAIN_EMIT=false
UPSTREAM_RETRY_BASE_DELAY_SECONDS=0.1
UPSTREAM_RETRY_MAX_DELAY_SECONDS=2
UPSTREAM_RETRY_JITTER_RATIO=0.2
WORKER_RETRY_BASE_DELAY_SECONDS=1
WORKER_RETRY_MAX_DELAY_SECONDS=30
WORKER_RETRY_JITTER_RATIO=0.25

# Ingest mode. mock uses services/mocks; live needs the Bright Data values below.
# Live mode fails fast at startup and names the missing variable (never its value).
# Tenant that ingest writes for (never taken from a provider payload). The default is the demo
# tenant of `make seed`; use the tenant of your own users when you ingest real data.
INGEST_TENANT_ID=00000000-0000-4000-8000-0000000000a1
INGEST_MODE=mock
INGEST_POLL_ENABLED=true
INGEST_POLL_INTERVAL_SECONDS=300
SOURCE_MAPS_ENABLED=true
SOURCE_MAPS_DATASET_ID=
SOURCE_COMPUTRABAJO_ENABLED=true
SOURCE_COMPUTRABAJO_DATASET_ID=
SOURCE_LINKEDIN_COMPANIES_ENABLED=false
SOURCE_LINKEDIN_COMPANIES_DATASET_ID=
SOURCE_LINKEDIN_JOBS_ENABLED=false
SOURCE_LINKEDIN_JOBS_DATASET_ID=
SOURCE_INSTAGRAM_ENABLED=false
SOURCE_INSTAGRAM_DATASET_ID=
SOURCE_RUES_ENABLED=false
SOURCE_RUES_DATASET_ID=
PUBLIC_WEBHOOK_BASE_URL=
HOT_LEAD_WEBHOOK_URL=
SOCIO_DATA_DIR=data/socio

# Profile and browser frontend origin (CORS allowlist in the local profile).
APP_PROFILE=local
FRONTEND_ORIGIN=http://localhost:3000

# Ops workflows (n8n): RUES delta source and health alert e-mail addresses (local placeholders).
RUES_DELTA_URL=http://mocks:8000/mocks/rues/delta
OPS_ALERT_FROM=ops@localhost
OPS_ALERT_TO=ops@localhost
# Development user passwords are generated into .env by the seed step; leave blank here.
DEV_USER_PASSWORD_ADMIN=
DEV_USER_PASSWORD_STRATEGIST=
DEV_USER_PASSWORD_INTAKE=
DEV_USER_PASSWORD_BD_REP=
DEV_USER_PASSWORD_ANALYST=

# Internal service authentication placeholder for F0.
INTERNAL_SERVICE_TOKEN=local-development-token
# Dedicated n8n credential that mints only the 60 second pulse refresh token (D-33).
# Distinct from INTERNAL_SERVICE_TOKEN. Empty refuses every mint request.
N8N_SOCIOECO_MINT_CREDENTIAL=

# n8n / Bright Data are intentionally disabled until credentials are supplied.
BRIGHT_DATA_API_URL=https://api.brightdata.com
BRIGHT_DATA_API_TOKEN=
INGEST_WEBHOOK_URL=http://gateway:8000/api/v1/ingest/webhook/bd
TELEGRAM_WEBHOOK_URL=http://mocks:8000/mocks/telegram
N8N_ENCRYPTION_KEY=replace-me-for-local-use


# Per-service database role passwords (local defaults are placeholders; generated by the bootstrap flow)
# (identity and socio included; ops/bootstrap_env.py fills every blank value)
BOOTSTRAP_PASSWORD_INGEST=
BOOTSTRAP_PASSWORD_CORE=
BOOTSTRAP_PASSWORD_PULSE=
BOOTSTRAP_PASSWORD_BRIEF=
BOOTSTRAP_PASSWORD_ML=
BOOTSTRAP_PASSWORD_IDENTITY=
BOOTSTRAP_PASSWORD_SOCIO=
# Identity (Django) database access: Compose sets POSTGRES_HOST and takes the password
# from BOOTSTRAP_PASSWORD_IDENTITY; set these only when running identity outside Compose.
POSTGRES_HOST=postgres
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=
# Outside the local profile the bootstrap refuses empty or CHANGE_ME_ role passwords.

# Drift worker (compose profile "lens", REQ-LNS-007); not started by `make invent-tracker`.
# Alerts go to the webhook only when URL, header name, and header value are all set; keep the
# header value secret and never commit a real one. An empty tenant falls back to INGEST_TENANT_ID.
DRIFT_ALERT_WEBHOOK_URL=
DRIFT_ALERT_HEADER_NAME=
DRIFT_ALERT_HEADER_VALUE=
DRIFT_TENANT_ID=
DRIFT_RUN_HOUR_UTC=7

# Host bind address of the Postgres and Redis published ports (default loopback).
# Change only to expose them deliberately, for example on a trusted network.
# Set to 0.0.0.0 to expose. Listed uncommented because ops/check_configuration.py
# requires every Compose variable here; the value equals the default.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
