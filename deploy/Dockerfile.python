# Shared image for Python APIs and workers. Relates to pyproject.toml,
# docker-compose.yml, and services/* modules; it copies only the runtime needed
# to keep the build small while service boundaries are refined.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY libs ./libs
COPY config ./config
COPY services ./services
COPY datagen ./datagen
COPY ops ./ops
COPY migrations ./migrations

# PYTHONPATH=/app makes /app/libs win over the site-packages copy, so the files read by
# repository path (config/funnel/*.yaml, libs/domain/validation_thresholds.yaml) resolve.
# psycopg is needed only by ops/bootstrap_roles.py (bootstrap-roles service).
RUN pip install --no-cache-dir ".[streamlit]" "psycopg[binary]>=3.2,<4"

EXPOSE 8000

